{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/TugasProject_CyberSec_SIPADU_Desa_Tundagan.docx",
      "destination": "/TugasProject_CyberSec_SIPADU_Desa_Tundagan.docx"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
