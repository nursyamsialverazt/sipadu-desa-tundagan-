# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public FQDN/URL where this application is deployed.
APP_URL="MY_APP_URL"

# PORT: Server port (default 3000)
PORT=3000

# NODE_ENV: Set to "production" when deployed over HTTPS
NODE_ENV="development"

# JWT_SECRET: Cryptographically strong secret key (min 32 chars) for signing session JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_LONG_RANDOM_SECRET_IN_PRODUCTION"

# SEED_ADMIN_PASSWORD: Optional override for initial admin seed password in development
SEED_ADMIN_PASSWORD=""
